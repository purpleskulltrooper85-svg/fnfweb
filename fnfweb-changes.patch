-    const help = this.binding
-      ? 'Press a key to bind (ESC cancels)'
-      : 'UP/DOWN select  -  LEFT/RIGHT change (SHIFT = x10)  -  ENTER toggle/rebind  -  BACKSPACE reset  -  ESC back';
